# Supabase Configuration Examples
# Replace these values with your actual project keys from the Supabase dashboard
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-jwt"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: Tavily Search API key (1 000 free searches/month at https://tavily.com)
# When set in Vercel environment variables, enables automated LinkedIn candidate extraction for all users
TAVILY_API_KEY="tvly-..."
